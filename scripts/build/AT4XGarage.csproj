<!-- Optional: compile AT4XGarage.cs into AT4XGarage.dll (`dotnet build -c Release`).
     Not required - ScriptHookVDotNet can load AT4XGarage.cs directly from the scripts folder. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>5</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>AT4XGarage</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../AT4XGarage.cs" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="ScriptHookVDotNet3" Version="3.6.0" />
    <PackageReference Include="LemonUI.SHVDN3" Version="2.1.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
