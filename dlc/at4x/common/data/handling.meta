<?xml version="1.0" encoding="UTF-8"?>
<!--
  GMC Sierra 1500 AT4X - handling tuned toward the real truck:
    6.2L L87 V8 (420 hp / 460 lb-ft), 10-speed auto, full-time 4WD w/ front + rear e-lockers,
    ~2,640 kg curb weight, 33in mud-terrain tires, Multimatic DSSV spool-valve dampers.
  GTA has no 10-speed model, so the gearing is approximated with 6 ratios.
  Engine/brake/transmission/suspension upgrades and the Whipple package stack on top of this.
-->
<CHandlingDataMgr>
  <HandlingData>
    <Item type="CHandlingData">
      <handlingName>AT4X</handlingName>
      <fMass value="2640.000000" />
      <fInitialDragCoeff value="9.000000" />
      <fPercentSubmerged value="85.000000" />
      <vecCentreOfMassOffset x="0.000000" y="0.050000" z="0.020000" />
      <vecInertiaMultiplier x="1.200000" y="1.400000" z="1.600000" />
      <!-- 4WD Auto: ~40/60 front/rear -->
      <fDriveBiasFront value="0.400000" />
      <nInitialDriveGears value="6" />
      <fInitialDriveForce value="0.300000" />
      <fDriveInertia value="1.000000" />
      <fClutchChangeRateScaleUpShift value="3.200000" />
      <fClutchChangeRateScaleDownShift value="3.200000" />
      <!-- ~158 km/h (98 mph) governed top speed -->
      <fInitialDriveMaxFlatVel value="168.000000" />
      <fBrakeForce value="0.550000" />
      <fBrakeBiasFront value="0.600000" />
      <fHandBrakeForce value="0.650000" />
      <fSteeringLock value="38.000000" />
      <!-- mud-terrain grip: a little less on tarmac, forgiving off-road -->
      <fTractionCurveMax value="2.150000" />
      <fTractionCurveMin value="1.950000" />
      <fTractionCurveLateral value="22.000000" />
      <fTractionSpringDeltaMax value="0.150000" />
      <fLowSpeedTractionLossMult value="0.700000" />
      <fCamberStiffnesss value="0.000000" />
      <fTractionBiasFront value="0.490000" />
      <fTractionLossMult value="0.500000" />
      <!-- DSSV dampers: soft over bumps, controlled rebound, long travel -->
      <fSuspensionForce value="1.900000" />
      <fSuspensionCompDamp value="1.300000" />
      <fSuspensionReboundDamp value="2.000000" />
      <fSuspensionUpperLimit value="0.180000" />
      <fSuspensionLowerLimit value="-0.220000" />
      <fSuspensionRaise value="0.000000" />
      <fSuspensionBiasFront value="0.520000" />
      <fAntiRollBarForce value="0.450000" />
      <fAntiRollBarBiasFront value="0.550000" />
      <fRollCentreHeightFront value="0.420000" />
      <fRollCentreHeightRear value="0.420000" />
      <fCollisionDamageMult value="0.700000" />
      <fWeaponDamageMult value="1.000000" />
      <fDeformationDamageMult value="0.600000" />
      <fEngineDamageMult value="1.200000" />
      <!-- 24 gal tank -->
      <fPetrolTankVolume value="91.000000" />
      <fOilVolume value="7.500000" />
      <fSeatOffsetDistX value="0.000000" />
      <fSeatOffsetDistY value="0.000000" />
      <fSeatOffsetDistZ value="0.000000" />
      <nMonetaryValue value="85000" />
      <!-- ABS + independent front / solid rear axle -->
      <strModelFlags>240010</strModelFlags>
      <!-- smoothed compression + off-road abilities -->
      <strHandlingFlags>20001</strHandlingFlags>
      <strDamageFlags>0</strDamageFlags>
      <AIHandling>AVERAGE</AIHandling>
      <SubHandlingData>
        <Item type="CCarHandlingData">
          <fBackEndPopUpCarImpulseMult value="0.100000" />
          <fBackEndPopUpBuildingImpulseMult value="0.030000" />
          <fBackEndPopUpMaxDeltaSpeed value="0.600000" />
        </Item>
        <Item type="NULL" />
        <Item type="NULL" />
      </SubHandlingData>
    </Item>
  </HandlingData>
</CHandlingDataMgr>
